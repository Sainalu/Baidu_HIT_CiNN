+class Gemma3CINNCompatibilityTest(unittest.TestCase):
+    def test_sliding_window_mask_matches_reference(self):
+        for batch_size, seq_length, past_length, window_size in ((1, 7, 0, 3), (2, 5, 4, 4)):
+            expected = paddle.zeros([seq_length, past_length + seq_length], dtype="bool")
+            for index in range(seq_length):
+                current = past_length + index
+                expected[index, max(0, current - window_size + 1) : current + 1] = True
+            expected = expected.unsqueeze(0).unsqueeze(0).tile([batch_size, 1, 1, 1])
+
+            actual = _make_sliding_window_mask(
+                (batch_size, seq_length), past_key_values_length=past_length, window_size=window_size
+            )
+
+            self.assertTrue(paddle.equal_all(actual, expected))
+
+    def test_rms_norm_does_not_enter_python_autocast_context(self):
+        config = Gemma3TextConfig(
+            vocab_size=64,
+            hidden_size=32,
+            intermediate_size=64,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=8,
+            max_position_embeddings=64,
+        )
+        model = Gemma3TextModel(config)
+        x = paddle.randn([2, 4, 32])
+
+        with mock.patch("paddle.amp.auto_cast", side_effect=AssertionError("unexpected auto_cast context")):
+            output = model.norm(x)
+
+        self.assertEqual(output.shape, x.shape)
+
+    def test_attention_mask_dtype_min_matches_paddle_finfo(self):
+        model = Gemma3TextModel(
+            Gemma3TextConfig(
+                vocab_size=64,
+                hidden_size=32,
+                intermediate_size=64,
+                num_hidden_layers=1,
+                num_attention_heads=4,
+                num_key_value_heads=2,
+                head_dim=8,
+                max_position_embeddings=64,
+            )
+        )
+        attention_mask = paddle.ones([1, 4], dtype="bool")
+        attention_mask[:, -1] = False
+
+        for dtype in (paddle.float16, paddle.bfloat16, paddle.float32):
+            actual = model._prepare_decoder_attention_mask(attention_mask, (1, 4), 0, dtype)
+            self.assertEqual(float(actual.min()), float(paddle.finfo(dtype).min))
