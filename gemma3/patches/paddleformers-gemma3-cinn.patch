+import unittest
+from unittest import mock
+
+import paddle
+import paddle.nn as nn
+
+from paddleformers.transformers.tensor_parallel_utils import parallel_matmul
+
+
+class ParallelMatmulTest(unittest.TestCase):
+    def test_single_card_does_not_access_uninitialized_fleet_group(self):
+        x = paddle.randn([2, 3])
+        weight = nn.Linear(3, 5, bias_attr=False).weight
+
+        with mock.patch(
+            "paddleformers.transformers.tensor_parallel_utils.fleet.get_hybrid_communicate_group",
+            side_effect=AssertionError("fleet is not initialized"),
+        ) as get_group:
+            actual = parallel_matmul(
+                x,
+                weight,
+                transpose_y=False,
+                tensor_model_parallel_size=1,
+                tensor_parallel_output=False,
+            )
+
+        expected = paddle.matmul(x, weight)
+        self.assertTrue(paddle.allclose(actual, expected))
+        get_group.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
